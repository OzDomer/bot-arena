{
  "name": "@arena/backend",
  "type": "module",
  "private": true,
  "dependencies": {
    "@arena/sim": "*0.1.0",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --conditions=@arena/source src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
